---
import { Picture } from "astro:assets";
import type { ImageFunction, z } from "astro:content";

export interface Props {
  image: z.infer<ReturnType<ImageFunction>>;
  alt: string;
}

const { image, alt } = Astro.props;
---

<button
  type="button"
  class="contents"
  onclick="this.nextElementSibling?.showModal?.()"
>
  <div
    size="35 ms:40 md:50"
    overflow-hidden
    cursor="hover:pointer"
    transition-transform
    flex
    items-center
    justify-center
    class="hover:scale-105 thumbnail-container"
  >
    <Picture
      src={image}
      {alt}
      class={image.width < image.height ? "w-full h-auto" : "h-full w-auto"}
      widths={[
        image.width < image.height ? 200 : (200 * image.width) / image.height,
      ]}
    />
  </div>
</button>

<dialog
  max-h="[calc(100%-6em-6px)]"
  class="backdrop:bg-#e8eaedbf backdrop:backdrop-blur-md"
>
  <Picture
    src={image}
    {alt}
    class="max-w-full max-h-[100dvh_-_6em_-_6px] w-auto h-auto object-contain"
  />

  <button
    type="button"
    onclick="this.closest('dialog')?.close()"
    fixed
    top-4
    right-4
    flex
    items-center
    justify-center
    p="1.5"
    outline="focus-visible:none"
  >
    <i i-carbon-close-large inline-block size-5></i>
  </button>
</dialog>

<style>
  dialog :global(picture),
  .thumbnail-container :global(picture) {
    display: contents;
  }
</style>
